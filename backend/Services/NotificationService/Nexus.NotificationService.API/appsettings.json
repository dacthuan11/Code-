{
  "ConnectionStrings": {
    "DefaultConnection": "Host=postgres;Port=5432;Database=nexus_notification;Username=nexus_admin;Password=nexus_pass"
  },
  "Jwt": {
    "Key": "YOUR_JWT_SECRET_KEY_MIN_32_CHARS_HERE",
    "Issuer": "nexus-platform",
    "ExpiresInMinutes": 60
  },
  "RabbitMQ": {
    "Host": "rabbitmq",
    "VHost": "/",
    "User": "nexus",
    "Pass": "nexus_pass"
  },
  "SendGrid": {
    "ApiKey": "YOUR_SENDGRID_KEY_HERE",
    "FromEmail": "noreply@nexus-platform.com",
    "FromName": "Nexus Platform"
  },
  "Firebase": {
    "CredentialsPath": "/app/secrets/firebase-credentials.json"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
