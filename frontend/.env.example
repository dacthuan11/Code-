# Copy file này thành .env.local rồi điền giá trị thật
# .env.local sẽ bị gitignore tự động (*.local pattern)

# URL của API Gateway
# - Dev local: để trống (Vite proxy tự xử lý)
# - Staging/Production: điền URL Gateway thật
VITE_API_BASE_URL=

# URL Gateway để vite.config.ts biết proxy target (chỉ dùng trong dev)
VITE_GATEWAY_URL=http://localhost:5000
